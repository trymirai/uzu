<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Liquid Glass icon in Resources/Assets.car, compiled from icons/AppIcon.icon (Icon Composer). -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<!-- Updated installs keep the Mirai.app folder; Finder shows the en.lproj name only while this matches it. -->
	<key>CFBundleDisplayName</key>
	<string>Mirai</string>
	<key>LSHasLocalizedDisplayName</key>
	<true/>
</dict>
</plist>
