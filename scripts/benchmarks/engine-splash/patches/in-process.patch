index 0000000..bb863e7
--- /dev/null
+++ b/install/inprocess.py
@@ -0,0 +1,93 @@
+"""The engine's commands inside this process, where none can be started (iOS),
+with the subset of subprocess.run and subprocess.Popen that Splash uses."""
+
+import ctypes
+import os
+import subprocess
+import threading
+
+
+def _engine():
+    import splash_bindings
+
+    return splash_bindings
+
+
+def _main(args, input, output):
+    argv = (ctypes.POINTER(ctypes.c_char) * (len(args) + 1))(
+        *(ctypes.create_string_buffer(str(arg).encode()) for arg in args), None
+    )
+    return _engine().benchmarks_splash_main(len(args), argv, input, output)
+
+
+def _drain(descriptor, chunks):
+    with os.fdopen(descriptor, "rb") as stream:
+        chunks.append(stream.read())
+
+
+def run(args, *, check=False, capture_output=False, text=False):
+    """Run a check that writes to stdout and stderr, as subprocess.run does."""
+    if not capture_output:
+        returncode = _main(args, 0, 1)
+        stdout = stderr = None
+    else:
+        saved = [os.dup(1), os.dup(2)]
+        pipes = [os.pipe(), os.pipe()]
+        outputs = [[], []]
+        readers = [threading.Thread(target=_drain, args=(pipe[0], chunks)) for pipe, chunks in zip(pipes, outputs)]
+        for reader in readers:
+            reader.start()
+        try:
+            for descriptor, pipe in zip((1, 2), pipes):
+                os.dup2(pipe[1], descriptor)
+                os.close(pipe[1])
+            returncode = _main(args, 0, 1)
+        finally:
+            for descriptor, copy in zip((1, 2), saved):
+                os.dup2(copy, descriptor)
+                os.close(copy)
+            for reader in readers:
+                reader.join()
+        stdout, stderr = (b"".join(chunks) for chunks in outputs)
+        if text:
+            stdout, stderr = stdout.decode(), stderr.decode()
+    if check and returncode:
+        raise subprocess.CalledProcessError(returncode, args, stdout, stderr)
+    return subprocess.CompletedProcess(args, returncode, stdout, stderr)
+
+
+class Popen:
+    """The native server on a thread, with pipes for its frames and the
+    shared stderr, as subprocess.Popen(stdin=PIPE, stdout=PIPE, bufsize=0)."""
+
+    def __init__(self, args, **_):
+        self.args = args
+        self.pid = os.getpid()
+        self.returncode = None
+        input, writer = os.pipe()
+        reader, output = os.pipe()
+        self.stdin = os.fdopen(writer, "wb", buffering=0)
+        self.stdout = os.fdopen(reader, "rb", buffering=0)
+        self._thread = threading.Thread(target=self._serve, args=(input, output), daemon=True)
+        self._thread.start()
+
+    def _serve(self, input, output):
+        try:
+            self.returncode = _main(self.args, input, output)
+        finally:
+            os.close(input)
+            os.close(output)
+
+    def poll(self):
+        return None if self._thread.is_alive() else self.returncode
+
+    def wait(self, timeout=None):
+        self._thread.join(timeout)
+        if self._thread.is_alive():
+            raise subprocess.TimeoutExpired(self.args, timeout)
+        return self.returncode
+
+    def terminate(self):
+        _engine().benchmarks_splash_terminate()
+
+    kill = terminate
