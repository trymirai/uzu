        },
        {
          "anchor": "Community",
          "href": "https://discord.com/invite/trymirai",
          "icon": "discord"
        },
        {
          "anchor": "Blog",
          "href": "https://trymirai.com/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Write Us",
        "href": "mailto:contact@getmirai.co"
      }
