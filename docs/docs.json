{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Mirai Docs",
  "colors": {
    "primary": "#0A0A0A",
    "light": "#FCFCFC",
    "dark": "#0A0A0A"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "groups": [
      {
        "group": "Overview",
        "pages": [
          "index"
        ]
      },
      {
        "group": "Quick start",
        "pages": [
          "quick-start/chat",
          "quick-start/chat-cloud",
          "quick-start/chat-structured-output"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
