+// A ring slot's position is its age, a trie node's its height; a non-causal window reaches half its size either way.
+fn within_window(
+    node: usize,
+    key: usize,
+    prefix: usize,
+    ring: Option<usize>,
+    window: Option<usize>,
+    causal: bool,
+    nodes: Option<&[GpuTrieNode]>,
+) -> bool {
+    let height = |index: usize| nodes.map_or(index, |nodes| nodes[index].height as usize);
+    let position = if key >= prefix {
+        prefix + height(key - prefix)
+    } else {
+        ring.map_or(key, |offset| (prefix + key - offset) % prefix)
+    };
+    let query = prefix + height(node);
+    window.is_none_or(|window| {
+        if causal {
+            position <= query && query - position < window
+        } else {
+            position.abs_diff(query) <= window / 2
+        }
+    })
+}
